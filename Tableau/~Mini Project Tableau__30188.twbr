      <aliases enabled='yes' />
      <column caption='PY Profit ' datatype='real' name='[CY Profit (copy)_1773839650832392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate])= [Parameters].[Parameter 1773839578595330]-1 THEN [Profit]&#13;&#10;END' />
      </column>
      <column caption='PY Quantity ' datatype='integer' name='[CY Quantity (copy)_1773839657775119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate])= [Parameters].[Parameter 1773839578595330]-1 THEN [Quantity]&#13;&#10;END' />
      </column>
      <column caption='PY Sales  ' datatype='real' name='[CY Sales  (copy)_1773839578009601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate])= [Parameters].[Parameter 1773839578595330]-1 THEN [Sales]&#13;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0463223229980672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Is  Loss ' datatype='string' hidden='true' name='[Calculation_0600936958623744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss&quot; ELSE &quot;No Loss&quot; END' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0%' name='[Calculation_1152342052167680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column aggregation='CountD' caption='Order Line' datatype='string' default-role='measure' default-type='quantitative' hidden='true' name='[Calculation_1152342056611841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[OrderID] + &quot; | &quot; + [ProductName]' />
      </column>
      <column caption='Profit (+)' datatype='real' name='[Calculation_1743057582002176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1773839650213895]) &gt;= 0 THEN SUM([Calculation_1773839650213895]) END' />
      </column>
      <column caption='Profit (−)' datatype='real' name='[Calculation_1743057582116865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1773839650213895]) &lt;  0 THEN SUM([Calculation_1773839650213895]) END' />
      </column>
      <column caption='profit sign' datatype='string' hidden='true' name='[Calculation_1743057583276034]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= 0 THEN &quot;Profit&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_1744978603732993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([OrderID])' />
      </column>
      <column caption='Orders per Customer' datatype='real' name='[Calculation_1744978603913218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([OrderID]) / COUNTD([CustomerID])' />
      </column>
      <column caption='Profit per Customer' datatype='real' name='[Calculation_1744978604445699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / COUNTD([CustomerID])' />
      </column>
      <column caption='CY Sales ' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1773839577329664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate])= [Parameters].[Parameter 1773839578595330] THEN [Sales]&#13;&#10;END' />
      </column>
      <column caption='% Diff Sals' datatype='real' default-format='p0.0%' name='[Calculation_1773839580086275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1773839577329664])-SUM([CY Sales  (copy)_1773839578009601]))/SUM([CY Sales  (copy)_1773839578009601])' />
      </column>
      <column caption='Min/Max Sales ' datatype='real' hidden='true' name='[Calculation_1773839585898500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1773839577329664])= WINDOW_MAX(SUM([Calculation_1773839577329664]))&#13;&#10;THEN SUM([Calculation_1773839577329664])&#13;&#10;ELSEIF SUM([Calculation_1773839577329664])= WINDOW_MIN(SUM([Calculation_1773839577329664]))&#13;&#10;THEN SUM([Calculation_1773839577329664])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CY Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1773839650213895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([OrderDate])= [Parameters].[Parameter 1773839578595330] THEN [Profit]&#13;&#10;END' />
      </column>
      <column caption='% Diff Profit' datatype='real' name='[Calculation_1773839651127305]' role='measure' type='quantitative'>
